generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id      Int    @id
  postId  Int
  name    String
  email   String
  body    String
  version Int    @default(1)
  updatedAt DateTime @default(now()) @updatedAt
}
